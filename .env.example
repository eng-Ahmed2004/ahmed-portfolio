# Copy this file to .env.local and fill in what you need.
# Everything here is optional — the site runs without it.

# Final public address of the site (no trailing slash), e.g. a custom domain.
# Used for canonical URLs, the sitemap, robots.txt, and social cards.
# On Vercel the production URL is used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=

# Formspree form endpoint for the contact form, e.g. https://formspree.io/f/abcdwxyz
# Create the form at https://formspree.io with ahmadsrour537@gmail.com as recipient.
# This is a public form id, not a secret. Never put private API keys in
# NEXT_PUBLIC_* variables — they are sent to the browser.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
